{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "VITE_API_BASE_URL= npm run build",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "http://infraudit-production-773158614.us-east-1.elb.amazonaws.com/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
